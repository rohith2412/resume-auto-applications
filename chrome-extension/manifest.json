{
  "manifest_version": 3,
  "name": "reblet",
  "version": "1.1",
  "description": "Auto-fill LinkedIn Easy Apply forms with your AI-tailored resume.",

  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs"],

  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://reblet.com/*",
    "https://www.reblet.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["stealth.js", "qa-bank.js", "knowledge.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://reblet.com/*", "https://www.reblet.com/*"],
      "js": ["detect.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "reblet",
    "default_icon": "icons/icon128.png"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}
